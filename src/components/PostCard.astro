---
import { fmtDate, readingTime } from '../lib/site';
const { post, variant = 'card' } = Astro.props;
const d = post.data;
const href = `/blog/${post.id}/`;
const mins = readingTime(post.body);
// Sin portada: se genera una según la categoría (color + letras grandes)
const GEN: Record<string, string> = { 'IA': 'IA', 'Mi fé': 'Fe', 'Tecnología': 'Tec', 'Vida': 'Vida', 'Flag football': 'Flag' };
const CAT: Record<string, string> = { 'IA': 'ia', 'Mi fé': 'fe', 'Tecnología': 'tec', 'Vida': 'vida', 'Flag football': 'flag' };
const genClass = `cover gen gen-${CAT[d.category] || 'ia'}`;
---
{variant === 'row' ? (
  <a class="prow" href={href}><b>{d.category}</b><span>{d.title}</span><small>{mins} min</small></a>
) : variant === 'featured' ? (
  <a class="featured" href={href} data-category={d.category}>
    {d.cover ? <div class="cover"><img src={d.cover} alt="" style={d.cover_position ? `object-position:${d.cover_position}` : undefined} /></div> : <div class={genClass}><span class="gen-tag">{d.category}</span><span class="gen-big">{GEN[d.category] || d.category}</span></div>}
    <div class="featured-body">
      <span class="pill pill-blue">Destacado</span>
      <span class="kicker" style="font-size:13px">{d.category} · {mins} min</span>
      <h2>{d.title}</h2>
      {d.summary && <p style="color:var(--muted);font-size:17px">{d.summary}</p>}
      <span class="more">Leer artículo →</span>
    </div>
  </a>
) : (
  <a class="postc" href={href} data-category={d.category}>
    {d.cover ? <div class="cover"><img src={d.cover} alt="" loading="lazy" style={d.cover_position ? `object-position:${d.cover_position}` : undefined} /></div> : <div class={genClass}><span class="gen-tag">{d.category}</span><span class="gen-big">{GEN[d.category] || d.category}</span></div>}
    <span class="meta">{d.category} · {mins} min</span>
    <h3>{d.title}</h3>
    {d.summary && <p>{d.summary}</p>}
    <time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time>
  </a>
)}
