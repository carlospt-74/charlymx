---
import { getTeams } from '../lib/teams';
const teams = getTeams();
---
{teams.length > 0 && (
<section class="teams">
  <div class="sec-head"><h2>Mis equipos</h2><span class="sub-note">Se actualiza solo · hora de Monterrey</span></div>
  <div class="teams-grid">
    {teams.map((t) => (
      <a class="tcard" href={t.href} data-tcard data-soccer={t.soccer ? '1' : ''} data-path={t.path} data-espn={t.espn} data-abbr={t.abbr} data-name={t.name}
         style={`--tc-bg:${t.bg};--tc-accent:${t.accent};--tc-accent-fg:${t.accentFg};--tc-sub:${t.sub};--tc-link:${t.link};--tc-strip:${t.strip}`}>
        <div class="tcard-strip"></div>
        <div class="tcard-body">
          <div class="tcard-head">
            <div class="tcard-team">
              <div class="tbadge" style={`background:${t.accent};color:${t.accentFg}`}>{t.crest ? <img src={t.crest} alt="" width="32" height="32" loading="lazy" /> : t.abbr}</div>
              <div><h3>Mis {t.name}</h3><div class="tsub" data-meta>{t.league}</div></div>
            </div>
            <span class="tleague">{t.league}</span>
          </div>
          <div class="tlast" data-last><div class="tcap">Cargando resultados…</div></div>
          <div class="tnext" data-next hidden></div>
          <div class="tfoot"><span>{t.soccer ? 'Resultados y tabla general' : 'Calendario y tabla de división'}</span><b>Ver {t.league} →</b></div>
        </div>
      </a>
    ))}
  </div>
</section>
)}
<script>
  import { resolveTeam, schedule, standingsGroup, standing, sv, fDay, fHour, esc } from '../lib/sports';

  document.querySelectorAll<HTMLElement>('[data-tcard]').forEach(async (card) => {
    const { path, espn, abbr, name } = card.dataset as Record<string, string>;
    const soccer = !!card.dataset.soccer;
    const q = (s: string) => card.querySelector<HTMLElement>(s)!;
    try {
      const id = await resolveTeam(path, espn, abbr, name);
      const { team: t, games } = await schedule(path, id, soccer);
      const past = games.filter((g) => g.done);
      const next = games.find((g) => !g.done);
      if (soccer) {
        try {
          const grp = await standingsGroup(path, t.id);
          const me = grp?.standings.entries.find((e: any) => e.team?.id === t.id);
          if (me) q('[data-meta]').textContent = `${sv(me, 'rank')}° lugar · ${sv(me, 'points')} pts`;
        } catch {}
      } else {
        q('[data-meta]').textContent = [t.recordSummary && `Récord ${t.recordSummary}`, standing(t.standingSummary)].filter(Boolean).join(' · ');
      }
      const last = past[past.length - 1];
      if (last) {
        const homeName = last.home ? name : last.opp, awayName = last.home ? last.opp : name;
        const hs = last.home ? last.us : last.them, as = last.home ? last.them : last.us;
        const cap = soccer || !last.week ? `Último partido · ${fDay(last.date)} · Final` : `Semana ${last.week} · Final`;
        q('[data-last]').innerHTML = `<div class="tcap">${esc(cap)}</div>
          <div class="tscore"><div class="${last.home ? 'us' : ''}"><small>${esc(homeName)}</small><b>${esc(hs)}</b></div>
          <em>${last.home ? 'en casa' : 'de visita'}</em>
          <div class="r ${last.home ? '' : 'us'}"><small>${esc(awayName)}</small><b>${esc(as)}</b></div></div>`;
      } else q('[data-last]').innerHTML = '<div class="tcap">Aún no hay partidos jugados</div>';
      if (next) {
        const nx = q('[data-next]');
        nx.innerHTML = `<div><div class="tcap2">PRÓXIMO${next.week && !soccer ? ' · SEM ' + next.week : ''}</div><div class="ttxt">${esc(fDay(next.date))} · ${next.home ? 'vs' : 'en'} ${esc(next.opp)}</div></div>
          <div class="ttime">${next.tbd ? 'Por confirmar' : esc(fHour(next.date))}<br>${esc(next.tv || next.venue)}</div>`;
        nx.hidden = false;
      }
    } catch {
      q('[data-last]').innerHTML = '<div class="tcap">No se pudieron cargar los datos ahora</div>';
    }
  });
</script>
