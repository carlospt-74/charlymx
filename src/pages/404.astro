---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada">
  <div class="wrap" style="padding:96px var(--pad) 120px;display:flex;flex-direction:column;gap:20px;align-items:flex-start">
    <span class="kicker">Error 404</span>
    <h1 style="font-size:clamp(44px,7vw,84px);line-height:1;letter-spacing:-.035em">Esta jugada no salió.</h1>
    <p class="lead">La página que buscas no existe o cambió de lugar.</p>
    <a href="/" class="btn btn-blue">Volver al inicio</a>
  </div>
</Base>
